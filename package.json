{
  "name": "mcp-tool-xplorer",
  "displayName": "MCP Tool Xplorer",
  "description": "Browse MCP servers and their tools, favourite and search them, tag DEV, TEST, or PROD, inspect schemas, try a tool, and read a colour-coded response.",
  "version": "0.1.21",
  "publisher": "Garrard",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/garrardkitchen/vscode-mcp-tool-explorer"
  },
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "mcp",
    "model context protocol",
    "tools"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:mcpToolXplorer.tools"
  ],
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mcpToolXplorer",
          "title": "MCP Tool Xplorer",
          "icon": "media/mcp-tools.svg"
        }
      ]
    },
    "views": {
      "mcpToolXplorer": [
        {
          "type": "webview",
          "id": "mcpToolXplorer.tools",
          "name": "MCP Tool Xplorer",
          "contextualTitle": "MCP Tool Xplorer"
        }
      ]
    },
    "commands": [
      {
        "command": "mcpToolXplorer.refresh",
        "title": "Refresh Servers",
        "category": "MCP Tool Xplorer",
        "icon": "$(refresh)"
      },
      {
        "command": "mcpToolXplorer.openTool",
        "title": "Open Tool Details",
        "category": "MCP Tool Xplorer"
      },
      {
        "command": "mcpToolXplorer.tryTool",
        "title": "Try Tool",
        "category": "MCP Tool Xplorer",
        "icon": "$(play)"
      },
      {
        "command": "mcpToolXplorer.setClientSecret",
        "title": "Set Client Secret",
        "category": "MCP Tool Xplorer",
        "icon": "$(key)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "mcpToolXplorer.refresh",
          "when": "view == mcpToolXplorer.tools",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "mcpToolXplorer.openTool",
          "when": "false"
        },
        {
          "command": "mcpToolXplorer.tryTool",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run compile && vsce package --allow-missing-repository --no-rewrite-relative-links",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
